  "source": "\"\"\"Reconstruct shuffled batch exposure and cross-check reported token counts; no weights loaded.\"\"\"\nimport hashlib\nimport json\nimport re\nfrom collections import Counter\nfrom functools import partial\nfrom pathlib import Path\nimport numpy as np\nfrom mlx_lm.tuner import trainer\nfrom mlx_lm.tuner.datasets import ChatDataset, CacheDataset\nfrom transformers import AutoTokenizer\n\naudit = json.loads(Path('.context/canonical-token-weights.json').read_text())\nrows = audit['rows']\nassert len(rows) == 1024\nchats = [json.loads(line) for line in Path('Training/experiments/canonical-copy-inputs/train.jsonl').read_text().splitlines()]\ntokenizer = AutoTokenizer.from_pretrained('Models/Artifacts/quant-recovery-qwen-4bit', local_files_only=True, trust_remote_code=False)\ntokenizer.apply_chat_template = partial(tokenizer.apply_chat_template, enable_thinking=False)\ndataset = CacheDataset(ChatDataset(chats, tokenizer, mask_prompt=True))\nlookup = {tuple(dataset[i][0]): i for i in range(len(dataset))}\nassert len(lookup) == 1024\nassert all(len(dataset[i][0]) == r['total'] and len(dataset[i][0]) - dataset[i][1] == r['target'] for i, r in enumerate(rows))\nnp.random.seed(20260824)\nbatches = trainer.iterate_batches(dataset, 2, 2048, loop=True)\ncounts = Counter()\ntokens = 0\nsnapshots = {}\nlog = Path('.build/canonical-copy-training.log').read_text()\nreported = {int(step): int(count) for step, count in re.findall(r'Iter (\\d+): Train loss .*?Trained Tokens (\\d+)', log)}\nfor step in range(1, 601):\n    batch, lengths = next(batches)\n    # Validation uses the same numpy RNG and consumes one16-batch permutation.\n    if step == 1 or step % 100 == 0:\n        np.random.permutation(16)\n    indices = [lookup[tuple(row[:end])] for row, (_, end) in zip(batch.tolist(), lengths.tolist(), strict=True)]\n    counts.update(indices)\n    tokens += sum(end - offset + 1 for offset, end in lengths.tolist())\n    if step in reported:\n        assert tokens == reported[step], (step, tokens, reported[step])\n    if step in [300, 600]:\n        selected = [(i, r) for i, r in enumerate(rows) if r['id'].startswith('train-canonical-copy-')]\n        snapshots[str(step)] = dict(\n            tokenCount=tokens,\n            addedExampleExposures={r['id']: counts[i] for i, r in selected},\n            exposureHistogram=dict(Counter(counts[i] for i, _ in selected)))\nfit = json.loads(Path('Training/experiments/canonical-training-fit-2026-09-17.json').read_text())\nfor step, snapshot in snapshots.items():\n    failures = {r['id'] for r in fit['runs'][step]['failures']}\n    exposure = snapshot['addedExampleExposures']\n    snapshot['failureExposureHistogram'] = dict(Counter(exposure[id] for id in failures))\nrecord = dict(scope='Reconstructed batch order using actual pinned ChatDataset/CacheDataset/iterator and recorded seed, batch size, and validation schedule; every reported training-token total matches.',\n    batchingObservation='Pinned CacheDataset.itemlen reads len(raw record), not token length. All chat records have one dictionary key, so pairs follow corpus order before batch shuffling. The prior token-length-sorted weighting audit is invalid.',\n    snapshots=snapshots, source=Path(__file__).read_text(),\n    inputSHA256={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in [\n        Path('.context/canonical-token-weights.json'), Path('.build/canonical-copy-training.log'),\n        Path(trainer.__file__), Path('Training/experiments/canonical-training-fit-2026-09-17.json')]})\noutput = Path('Training/experiments/canonical-training-exposure-2026-09-17.json')\nassert not output.exists()\noutput.write_text(json.dumps(record, indent=2, sort_keys=True) + '\\n')\nfor step, snapshot in snapshots.items():\n    print(step, {k:v for k,v in snapshot.items() if k != 'addedExampleExposures'})\n"
}
