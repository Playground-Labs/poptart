  "question": "Can the existing native runtime execute the larger4bit model, and what are stock-model quality/resource observations on the same inputs?",
  "scope": "Development-only stock0.8B then stock2B, validation32 and previously observed canonical64, each with11adversarial. No adapter, model selection, new training, or frozen release query.",
  "source": "\"\"\"Fixed native stock-model feasibility comparison; no training, selection, or release query.\"\"\"\nimport datetime\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path('Evals').resolve()))\nimport baseline\n\nrunner = Path('.build/optimized-recovery-release-runner/PoptartCleanupEval')\nroot = Path('Training/experiments')\nmodels = {'0.8B': Path('Models/Artifacts/baseline-qwen-4bit'), '2B': Path('Models/Artifacts/baseline-qwen-2b-4bit')}\nfixtures = {name: root / 'canonical-copy-inputs' / file for name, file in [\n    ('validation', 'validation-gold.jsonl'), ('canonical', 'diagnostic-canonical.jsonl')]}\nadversarial = Path('Evals/fixtures/adversarial.jsonl')\nfor name, gold in fixtures.items():\n    baseline.evaluation.validate_fixtures(baseline.evaluation.load(gold), baseline.evaluation.load(adversarial))\n    assert len(baseline.evaluation.load(gold)) == (32 if name == 'validation' else 64)\nplan = dict(createdAt=datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    question='Can the existing native runtime execute the larger4bit model, and what are stock-model quality/resource observations on the same inputs?',\n    scope='Development-only stock0.8B then stock2B, validation32 and previously observed canonical64, each with11adversarial. No adapter, model selection, new training, or frozen release query.',\n    limitations=['These are stock models, not equally fine-tuned candidates; this cannot establish a trained-model capacity advantage.',\n                 'Ordered M5Pro Cleanup-only observations, uncontrolled host/cache state; not full Dictation or physicalM1 evidence.',\n                 'ADR0039 and all shipping quality/latency/architecture gates remain unchanged.'],\n    inputs={size:{name:baseline.execution_identity(runner, model, gold, adversarial) for name,gold in fixtures.items()} for size,model in models.items()},\n    preparationSHA256=baseline.digest(root/'qwen-2b-preparation-2026-09-17.json'),\n    source=Path(__file__).read_text())\nplan_path=root/'qwen-stock-size-plan-2026-09-17.json'\noutput=root/'qwen-stock-size-2026-09-17.json'\nassert not plan_path.exists() and not output.exists()\nplan_path.write_text(json.dumps(plan,indent=2,sort_keys=True)+'\\n')\nrecord=dict(status='Running fixed stock-size comparison.',plan=plan,runs={})\ndef retain():\n    output.write_text(json.dumps(record,indent=2,sort_keys=True)+'\\n')\nretain()\nfor size, model in models.items():\n    record['runs'][size]={}\n    for name, gold in fixtures.items():\n        assert baseline.execution_identity(runner,model,gold,adversarial)==plan['inputs'][size][name]\n        directory=Path(f'.build/qwen-stock-size-{size}-{name}')\n        command=[sys.executable,'Evals/baseline.py','--runner',str(runner),'--model',str(model),\n                 '--gold',str(gold),'--output-directory',str(directory)]\n        with Path(str(directory)+'.log').open('w') as log:\n            subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,check=True)\n        assert baseline.execution_identity(runner,model,gold,adversarial)==plan['inputs'][size][name]\n        run={key:json.loads((directory/(key+'.json')).read_text()) for key in ['report','evidence','failures']}\n        run['predictions']=baseline.evaluation.load(directory/'predictions.jsonl')\n        run['nativeResources']=(directory/'native-resources.txt').read_text()\n        assert run['report']['editPlanExact']['applicable']==(32 if name=='validation' else 64)\n        assert run['report']['runtimeConsistency']['applicable']==(43 if name=='validation' else 75)\n        record['runs'][size][name]=run\n        retain()\n        print(size,name,run['report']['editPlanExact'],flush=True)\nrecord['status']='Completed fixed stock-size comparison; no trained candidate or release qualification.'\nretain()\n"
}
