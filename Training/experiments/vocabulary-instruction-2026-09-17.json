  "probeSource": "\"\"\"Development-only paired prompt diagnostic; no production changes or holdout query.\"\"\"\nimport hashlib\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\nos.environ['HF_HUB_OFFLINE'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nsys.path[:0] = [str(Path(p).resolve()) for p in ('Training', 'Evals', 'Scripts')]\nfrom prepare_corpus import SYSTEM\nimport editplan\nimport model_files\nimport mlx.core as mx\nfrom mlx_lm import load, stream_generate\nfrom mlx_lm.sample_utils import make_sampler\n\nsource = Path('.build/literal-composition-development/predictions.jsonl')\nmodel_path = Path('Models/Artifacts/composition-qwen-adapter-v2')\noutput = Path('Training/experiments/vocabulary-instruction-2026-09-17.json')\nrule = (' For vocabulary edits, r must be an exact, case-sensitive member of personalVocabulary; '\n        'never invent a variant. If personalVocabulary is empty, emit no vocabulary edits.')\nrecord = dict(status='Predeclared Python diagnostic; not native or release evidence.',\n    hypothesis='An explicit exact-vocabulary constraint may correct invented vocabulary variants.',\n    control=SYSTEM, variant=SYSTEM + rule,\n    protocol='One fixed instruction variant; compare all 23 retained development/adversarial inputs '\n             'with control and native outputs. No selection among alternative prompts, no training, '\n             'no runtime validation changes, and no frozen release holdout query.',\n    inputSHA256=hashlib.sha256(source.read_bytes()).hexdigest(),\n    modelFiles=model_files.inventory(model_path), probeSource=Path(__file__).read_text(), rows=[])\nwith output.open('x') as stream:\n    json.dump(record, stream, indent=2, sort_keys=True)\nrows = [json.loads(line) for line in source.read_text().splitlines()]\nassert len(rows) == 23 and len({row['id'] for row in rows}) == 23\nmodel, tokenizer = load(str(model_path / 'base'), adapter_path=str(model_path / 'adapters'),\n                        tokenizer_config={'trust_remote_code': False})\nfor row in rows:\n    payload = json.loads(row['modelPrompt'].split('\\n', 2)[2])\n    result = dict(id=row['id'], nativeOutput=row['rawModelOutput'], runs={})\n    for label, system in [('control', SYSTEM), ('variant', SYSTEM + rule)]:\n        prompt = tokenizer.apply_chat_template(\n            [{'role': 'system', 'content': system}, {'role': 'user', 'content': row['modelPrompt']}],\n            add_generation_prompt=True, enable_thinking=False, tokenize=True, return_dict=False)\n        raw = ''\n        for chunk in stream_generate(model, tokenizer, prompt, max_tokens=128,\n                sampler=make_sampler(temp=0, top_p=1, top_k=1)):\n            raw += chunk.text\n            if '<END_PLAN>' in raw:\n                break\n        violation = None\n        edits = []\n        try:\n            body, marker, suffix = raw.partition('<END_PLAN>')\n            assert marker and not suffix, 'missing marker or trailing output'\n            edits = editplan.parse_plan(json.loads(body))\n            violation = editplan.plan_violation(edits, payload['rawTranscript'],\n                payload['personalVocabulary'], payload['reservedEdits'], payload)\n        except (AssertionError, ValueError) as error:\n            violation = str(error)\n        text = payload['rawTranscript'] if violation else editplan.apply_edits(\n            sorted(payload['reservedEdits'] + edits, key=lambda edit: (edit['s'], edit['e'])),\n            payload['rawTranscript'])\n        result['runs'][label] = dict(rawModelOutput=raw, inputTokens=len(prompt),\n            matchesNative=raw == row['rawModelOutput'], violation=violation, output=text)\n        mx.clear_cache()\n    record['rows'].append(result)\n    output.write_text(json.dumps(record, indent=2, sort_keys=True) + '\\n')\n    print(row['id'], result['runs']['control']['matchesNative'],\n          result['runs']['variant']['output'], flush=True)\nrecord['status'] = 'Completed Python diagnostic; not native or release evidence.'\noutput.write_text(json.dumps(record, indent=2, sort_keys=True) + '\\n')\n",
