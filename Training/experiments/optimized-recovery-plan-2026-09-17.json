  "preparationSource": "\"\"\"Retain freshly rebuilt runners and freeze recovery inputs before any model inference.\"\"\"\nimport hashlib,json,shutil,subprocess\nfrom pathlib import Path\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\noriginal=Path('Training/experiments/optimized-eval-plan-2026-09-17.json')\nplan=json.loads(original.read_text())\nsource={p:sha(p) for p in plan['sourceSHA256']}\nretained={};runners={};logs={}\nfor config in ['debug','release']:\n log=Path('.build/optimized-recovery-'+config+'-build.log')\n with log.open('w') as stream:\n  subprocess.run(['swift','build','-c',config,'--product','PoptartCleanupEval'],stdout=stream,stderr=subprocess.STDOUT,check=True)\n assert {p:sha(p) for p in source}==source\n directory=Path('.build/optimized-recovery-'+config+'-runner');directory.mkdir()\n products=Path('.build/out/Products/'+config.title())\n shutil.copy2(products/'PoptartCleanupEval',directory/'PoptartCleanupEval')\n for bundle in products.glob('*.bundle'):shutil.copytree(bundle,directory/bundle.name)\n runners[config]=str(directory/'PoptartCleanupEval')\n retained.update({str(p):sha(p) for p in directory.rglob('*') if p.is_file()})\n logs[config]=log.read_text()\nplan.update(sourceSHA256=source,retainedFilesSHA256=retained,runners=runners,buildLog=logs,\n buildCommand='swift build -c debug --product PoptartCleanupEval; swift build -c release --product PoptartCleanupEval (sequential)',\n sourceEvidence='Inputs hashed before and after both fresh builds. Only validator CharacterSet predicate implementation differs from interrupted pair; fresh debug control also rerun.',\n recoveryOf={'path':str(original),'sha256':sha(original),'result':'Training/experiments/optimized-eval-2026-09-17.json'},\n recoveryReason='Original optimized native rejection probes exposed whole-module CharacterSet predicate miscompilation. Explicit contains closures pass optimized Cleanup suite; preserve exact probe gate and rerun complete pair.',\n preparationSource=Path(__file__).read_text())\npath=Path('Training/experiments/optimized-recovery-plan-2026-09-17.json');assert not path.exists();path.write_text(json.dumps(plan,indent=2,sort_keys=True)+'\\n')\ndriver=Path('.context/run_optimized_eval.py').read_text().replace('optimized-eval-','optimized-recovery-')\nPath('.context/run_optimized_recovery.py').write_text(driver)\nprint(path,flush=True)\n",
